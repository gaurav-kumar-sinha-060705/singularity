# Copy to .env and adjust as needed. All vars optional with these defaults.

# --- Storage ---
# Local dev (default): SQLite, zero setup.
COMPASS_DATABASE_URL=sqlite:///./data/compass.db
# Production (Supabase Postgres) — add the +psycopg driver segment and sslmode:
# COMPASS_DATABASE_URL=postgresql+psycopg://postgres:YOUR-PASSWORD@db.YOUR-REF.supabase.co:5432/postgres?sslmode=require

# --- Embeddings ---
COMPASS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Ranking weights ---
COMPASS_FIT_WEIGHT=0.65
COMPASS_TRUST_WEIGHT=0.35
COMPASS_FLAG_PENALTY=0.07
COMPASS_DEFAULT_TOP_K=5

# --- MCP endpoint security ---
# Hosts allowed to call /mcp (DNS-rebinding guard). Comma-separated; supports :* port wildcards.
COMPASS_MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,[::1]:*,testserver
# When deployed on Render, RENDER_EXTERNAL_URL is injected automatically and its host
# is appended to this list — no manual edit needed there.

# --- HTTP protection ---
COMPASS_RATE_LIMIT_PER_MIN=60
