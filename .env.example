# Copy to .env and adjust as needed. All vars optional with these defaults.

# --- Storage ---
# Local dev (default): SQLite, zero setup.
SINGULARITY_DATABASE_URL=sqlite:///./data/singularity.db
# Production (Supabase Postgres) — add the +psycopg driver segment and sslmode:
# SINGULARITY_DATABASE_URL=postgresql+psycopg://postgres:YOUR-PASSWORD@db.YOUR-REF.supabase.co:5432/postgres?sslmode=require

# --- Embeddings ---
SINGULARITY_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Ranking weights ---
SINGULARITY_FIT_WEIGHT=0.65
SINGULARITY_TRUST_WEIGHT=0.35
SINGULARITY_FLAG_PENALTY=0.07
SINGULARITY_DEFAULT_TOP_K=5

# --- MCP endpoint security ---
# Hosts allowed to call /mcp (DNS-rebinding guard). Comma-separated; supports :* port wildcards.
SINGULARITY_MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,[::1]:*,testserver
# When deployed on Render, RENDER_EXTERNAL_URL is injected automatically and its host
# is appended to this list — no manual edit needed there.

# --- HTTP protection ---
SINGULARITY_RATE_LIMIT_PER_MIN=60

# --- OAuth / MCP connector ---
# On Render: auto-derives from RENDER_EXTERNAL_URL (set to your public HTTPS URL).
# For local dev tunnels (ngrok/cloudflare): set to the public tunnel URL.
# SINGULARITY_OAUTH_PUBLIC_BASE=https://singularity-xxxx.onrender.com
